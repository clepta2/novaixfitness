{
  "name": "novaix-backend",
  "version": "1.0.0",
  "description": "Backend API - NOVAIX FITNESS",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node src/server.ts",
    "dev": "nodemon src/server.ts",
    "backup": "node scripts/backup.js",
    "backup:daily": "node scripts/daily-backup.js",
    "test:webhook": "node test_webhooks.js",
    "test": "jest --coverage --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:workouts": "jest --testPathPattern=workouts --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  }
}
