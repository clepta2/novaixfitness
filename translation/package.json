{
  "name": "novaix-translation",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "description": "Plataforma de tradução offline para o Novaix Fitness - PT/EN/ES",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    }
  },
  "files": [
    "src/"
  ],
  "keywords": [
    "translation",
    "i18n",
    "fitness",
    "offline",
    "portuguese",
    "english",
    "spanish"
  ],
  "author": "Jeferson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/novaix/translation"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
