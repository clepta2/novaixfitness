{
  "expo": {
    "name": "NOVAIX FITNESS",
    "slug": "novaix-fitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "novaix",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.novaix.fitness"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#12161A"
      },
      "package": "com.novaix.fitness",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-apple-authentication",
        {
          "faciaIDPermission": "Permitir autenticação com Face ID"
        }
      ],
      "expo-sharing"
    ],
    "owner": "clepta2",
    "extra": {
      "supabaseUrl": "https://jkoteibpvwlmsilntpof.supabase.co",
      "eas": {
        "projectId": "f174d6e9-8bfb-4dbe-90e2-00c4f504a159"
      },
      "router": {}
    }
  }
}
