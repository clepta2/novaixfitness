{
  "expo": {
    "name": "NOVAIX FITNESS",
    "slug": "novaix-fitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "novaix",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#12161A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.novaix.fitness"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#12161A"
      },
      "package": "com.novaix.fitness"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-apple-authentication",
        {
          "faciaIDPermission": "Permitir autenticação com Face ID"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "supabaseUrl": "https://jkoteibpvwlmsilntpof.supabase.co",
      "eas": {
        "projectId": "novaix-fitness"
      }
    }
  }
}
